{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NetSSH",
  "version": "0.1.19",
  "identifier": "app.netssh.client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NetSSH",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 620,
        "backgroundColor": "#080b10",
        "visible": false,
        "decorations": true,
        "transparent": false
      },
      {
        "label": "splashscreen",
        "title": "NetSSH is starting",
        "url": "splashscreen.html",
        "width": 460,
        "height": 310,
        "center": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "backgroundColor": "#080b10"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQwMEFBNzBGRUFDNDJGRjgKUldUNEw4VHFENmNLUUtHbDVUcFpoVlRNV3NnZmpvYkdvY3JqZFV4U1ZqcnJUN3ozK21HTnZQOTAK",
      "endpoints": [
        "https://github.com/Fogzo/NetSSH/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
